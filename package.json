{
  "name": "@gamegeek-saikel/dsh-coding-preset",
  "version": "0.1.2",
  "description": "DEPRECATED: Windows-adapted DeepSeek Harness coding-mode agent preset with a persistent PowerShell 7 shell. DSH official now provides this functionality by default.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/check.mjs",
    "check": "node scripts/check.mjs",
    "prepack": "node scripts/check.mjs",
    "postinstall": "node scripts/install-preset.mjs"
  },
  "files": [
    "agent.cordis.yml",
    "preset.yml",
    "cordis.patch.yml",
    "presets",
    "dsh-coding-preset-client",
    "install.ps1",
    "packages",
    "scripts",
    "tests",
    "README.md",
    "README.zh-CN.md",
    "DEPRECATED.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saikel-Orado-Liu/dsh-coding-preset.git"
  },
  "homepage": "https://github.com/Saikel-Orado-Liu/dsh-coding-preset#readme",
  "bugs": {
    "url": "https://github.com/Saikel-Orado-Liu/dsh-coding-preset/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-preset",
    "dsh-plugin",
    "coding-agent",
    "windows",
    "powershell",
    "pwsh"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dsh-coding-preset-client/lib/index.js",
  "exports": {
    ".": "./dsh-coding-preset-client/lib/index.js",
    "./client": "./dsh-coding-preset-client/lib/client.js",
    "./package.json": "./package.json"
  }
}
